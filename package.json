{
  "name": "wallpaper-workshop",
  "private": true,
  "version": "1.0.11",
  "description": "Wallpaper Engine 创意工坊客户端：浏览 / 搜索 / 筛选 / 排序 / 订阅 / 收藏，可独立运行，也可作为子应用接入 wallpaper-manager",
  "type": "commonjs",
  "main": "electron/main.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "icons": "node scripts/make-icons.js",
    "selftest": "node scripts/selftest.js",
    "debug:dns": "node scripts/debug-dns.js",
    "electron": "electron .",
    "desktop": "node scripts/run-desktop.js",
    "desktop:wait": "node scripts/run-desktop.js --wait",
    "desktop:build": "node scripts/build-dir.js && node scripts/run-desktop.js",
    "app:path": "node -e \"console.log(require('./scripts/lib/app-dir').resolveOutDir())\"",
    "fix:integrity": "node scripts/fix-integrity.js",
    "dist:dir": "node scripts/build-dir.js",
    "dist:dir:fast": "node scripts/build-dir.js --fast",
    "dist:dir:inplace": "node scripts/build-dir.js --out=dist/win-unpacked",
    "dist": "node scripts/build.js --win",
    "dist:builder-dir": "node scripts/build.js --win --dir",
    "dist:offline": "node scripts/build.js --win -c.electronDist=node_modules/electron/dist"
  },
  "build": {
    "appId": "com.zjs248.wallpaperworkshop",
    "productName": "WallpaperWorkshop",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**",
      "server.js",
      "server/**",
      "src/**",
      "public/**",
      "index.html",
      "package.json",
      "!scripts/**",
      "!config/**",
      "!**/*.md"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "electron/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "创意工坊"
    }
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "wallpaper-engine",
    "steam-workshop",
    "steam",
    "431960"
  ],
  "license": "MIT",
  "author": "ZJS248",
  "dependencies": {},
  "devDependencies": {
    "electron": "^26.3.0",
    "electron-builder": "^25.1.8"
  }
}
